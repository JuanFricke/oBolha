# LLM API Keys (set at least one)
# ANTHROPIC_API_KEY=sk-ant-...   # Anthropic — uses claude-haiku-4-5 (cheapest)
# GROQ_API_KEY=gsk_...           # Free key at https://console.groq.com
# GEMINI_API_KEY=AIzaSy...        # Google GenAI / Gemini API key
# ANTIGRAVITY_API_KEY=...         # Antigravity SDK key

# Output folders
# CLIPPER_CLIPS_DIR=./clips          # clips cortados (com legendas)
# CLIPPER_REACTS_DIR=./reacts        # clips prontos com react/facecam
# CLIPPER_REACTS_SOURCE_DIR=./reacts_pool  # pool de vídeos react para modo auto
# CLIPPER_SHORTS_TOP=10                    # shorts CLI: quantos baixar
# CLIPPER_SHORTS_SCAN=100                  # shorts CLI: quantos analisar para rankear
# CLIPPER_OUTPUT_DIR=./clips         # legado: alias para CLIPPER_CLIPS_DIR

# Optional overrides
CLIPPER_PROVIDER=anthropic      # anthropic (haiku) | auto | groq | gemini | antigravity
# CLIPPER_MODEL=                  # ignored for anthropic (always claude-haiku-4-5)
# CLIPPER_LANG=pt
# CLIPPER_MAX_CLIPS=20
# CLIPPER_MIN_DURATION=20
# CLIPPER_MAX_DURATION=60
# CLIPPER_WORKERS=3
# CLIPPER_WHISPER_MODEL=base

# YouTube schedule (web UI → aba YouTube)
# YOUTUBE_CLIENT_ID=...apps.googleusercontent.com
# YOUTUBE_CLIENT_SECRET=...
# YOUTUBE_REDIRECT_URI=http://127.0.0.1:8765/api/youtube/callback
# CLIPPER_DATA_DIR=./data

# Watch + Postiz (worker)
# CLIPPER_SHORTS_CHANNEL=@renansantosmbl
# CLIPPER_POLL_SECONDS=900
# POSTIZ_BASE_URL=https://postiz-x4rk.srv700899.hstgr.cloud/api/public/v1
# POSTIZ_API_KEY=
# POSTIZ_PLATFORMS=youtube,tiktok,instagram,facebook
